#!/bin/sh
# Installed application and signed maintenance commands.
set -eu
APP_DIR="/opt/qlh-edge-inference"
case "${1:-tui}" in
    ui|web|tui|headless)
        mode="${1:-tui}"
        [ "$#" -eq 0 ] || shift
        exec "$APP_DIR/bin/qlh-app" "--$mode" "$@" ;;
    chat)
        shift
        exec "$APP_DIR/venv/bin/python" "$APP_DIR/src/tui_chat.py" "$@" ;;
    update)
        shift
        exec "$APP_DIR/bin/qlh-maintenance" check "$@" ;;
    check|download|install|version-status|version-stage|version-activate|version-rollback|version-recover|diagnostics|verify|diagnose|repair|data-status|retain-data|reassociate-data|reinstall)
        exec "$APP_DIR/bin/qlh-maintenance" "$@" ;;
    version) cat "$APP_DIR/version.txt" ;;
    --help|-h)
        printf '%s\n' 'bjtu tui|ui|headless: application' 'bjtu update|verify|diagnose|repair: signed maintenance' 'bjtu version-status|version-stage|version-activate|version-rollback|version-recover' 'bjtu retain-data|reassociate-data|reinstall: preserve user data' ;;
    *) exec "$APP_DIR/bin/qlh-app" "$@" ;;
esac
